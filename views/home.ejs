<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <title>Shortly — URL Shortener</title>
  <style>
    body { font-family: 'Inter', system-ui, sans-serif; }
    .glass { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(12px); }
    .url-card:hover { transform: translateY(-1px); }
    .copy-success { animation: pulse 0.4s ease; }
    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
  </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-50 via-indigo-50/40 to-slate-100 text-slate-800 antialiased">
  <% const userUrls = locals.urls || []; %>
  <% const user = locals.user || null; %>

  <!-- Header -->
  <header class="sticky top-0 z-30 border-b border-slate-200/80 glass">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3 sm:px-6">
      <a href="/" class="flex items-center gap-2.5">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-white shadow-md shadow-brand-600/25">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
          </svg>
        </span>
        <span class="text-lg font-semibold tracking-tight text-slate-900">Shortly</span>
      </a>

      <div class="flex items-center gap-3">
        <% if (user) { %>
          <a href="/profile" class="flex items-center gap-2.5 rounded-full py-1 pl-1 pr-2.5 transition hover:bg-slate-100/80" title="View profile">
            <% if (user.profileImg) { %>
              <img src="<%= user.profileImg %>" alt="" class="h-8 w-8 rounded-full object-cover ring-2 ring-white shadow-sm" />
            <% } else { %>
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-100 text-sm font-semibold text-brand-700 ring-2 ring-white">
                <%= (user.fullname || user.email || 'U').charAt(0).toUpperCase() %>
              </span>
            <% } %>
            <span class="hidden text-sm font-medium text-slate-700 sm:inline">
              <%= user.fullname || user.email || 'User' %>
            </span>
          </a>
          <form action="/user/logout" method="POST">
            <button type="submit" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 shadow-sm transition hover:border-slate-300 hover:bg-slate-50">
              Log out
            </button>
          </form>
        <% } else { %>
          <a href="/login" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 shadow-sm transition hover:bg-slate-50">Log in</a>
          <a href="/signup" class="rounded-lg bg-brand-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm transition hover:bg-brand-700">Sign up</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-5xl space-y-8 px-4 py-8 sm:px-6 sm:py-12">

    <!-- Hero + Create form -->
    <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-xl shadow-slate-200/50">
      <div class="bg-gradient-to-r from-brand-600 to-indigo-500 px-6 py-8 sm:px-8 sm:py-10">
        <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Shorten links in seconds</h1>
        <p class="mt-2 max-w-xl text-indigo-100">Paste any long URL and get a clean, shareable short link. Track clicks and manage everything in one place.</p>
      </div>

      <div class="px-6 py-6 sm:px-8 sm:py-8">
        <form action="/urls" method="POST" class="flex flex-col gap-3 sm:flex-row sm:items-end">
          <div class="flex-1">
            <label for="url" class="mb-1.5 block text-sm font-medium text-slate-700">Long URL</label>
            <input
              id="url"
              name="url"
              type="url"
              placeholder="https://example.com/very/long/path"
              required
              autocomplete="url"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 placeholder:text-slate-400 outline-none transition focus:border-brand-500 focus:bg-white focus:ring-4 focus:ring-brand-500/15"
            />
          </div>
          <button
            type="submit"
            class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3 font-semibold text-white shadow-lg shadow-brand-600/25 transition hover:bg-brand-700 focus:outline-none focus:ring-4 focus:ring-brand-500/30 active:scale-[0.98]"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
            </svg>
            Shorten
          </button>
        </form>

        <% if (locals.shortenedURL) { %>
          <div class="mt-5 flex flex-col gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
              <p class="text-sm font-medium text-emerald-800">
                <%= locals.duplicateURL ? "This URL already has a short link" : "Your short link is ready" %>
              </p>
              <p class="mt-1 truncate font-mono text-base text-emerald-900" id="result-short-url">
                <%= typeof window !== 'undefined' ? '' : '' %><span id="short-link-text"><%= shortenedURL.shortId %></span>
              </p>
              <p class="mt-0.5 text-xs text-emerald-700/80">Open: /<%= shortenedURL.shortId %></p>
            </div>
            <div class="flex shrink-0 gap-2">
              <button
                type="button"
                onclick="copyShortLink('<%= shortenedURL.shortId %>')"
                class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3.5 py-2 text-sm font-medium text-white transition hover:bg-emerald-700"
                id="copy-btn"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                Copy
              </button>
              <a
                href="/<%= shortenedURL.shortId %>"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1.5 rounded-lg border border-emerald-300 bg-white px-3.5 py-2 text-sm font-medium text-emerald-800 transition hover:bg-emerald-50"
              >
                Open
              </a>
            </div>
          </div>
        <% } %>
      </div>
    </section>

    <!-- URL list -->
    <section>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-slate-900">
          Your links
          <span class="ml-1.5 rounded-full bg-slate-200/80 px-2 py-0.5 text-sm font-medium text-slate-600"><%= userUrls.length %></span>
        </h2>
      </div>

      <% if (userUrls.length === 0) { %>
        <div class="rounded-2xl border border-dashed border-slate-200 bg-white/60 px-6 py-16 text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
            </svg>
          </div>
          <p class="mt-4 font-medium text-slate-700">No short links yet</p>
          <p class="mt-1 text-sm text-slate-500">Paste a URL above to create your first one.</p>
        </div>
      <% } else { %>
        <div class="space-y-3">
          <% userUrls.forEach((url) => { %>
            <article class="url-card group flex flex-col gap-4 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition duration-200 hover:border-slate-300 hover:shadow-md sm:flex-row sm:items-center sm:justify-between sm:p-5">
              <div class="min-w-0 flex-1 space-y-1.5">
                <div class="flex flex-wrap items-center gap-2">
                  <a
                    href="/<%= url.shortId %>"
                    class="font-mono text-base font-semibold text-brand-600 hover:text-brand-700 hover:underline"
                    target="_blank"
                    rel="noopener"
                  >
                    /<%= url.shortId %>
                  </a>
                  <button
                    type="button"
                    onclick="copyShortLink('<%= url.shortId %>', this)"
                    class="rounded-md p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600"
                    title="Copy short link"
                    aria-label="Copy short link"
                  >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                  </button>
                </div>
                <p class="truncate text-sm text-slate-500" title="<%= url.redirectURL %>">
                  <%= url.redirectURL %>
                </p>
              </div>

              <div class="flex shrink-0 items-center gap-4">
                <div class="flex items-center gap-1.5 rounded-lg bg-slate-50 px-3 py-1.5 text-sm text-slate-600">
                  <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  <span class="font-medium"><%= url.visitHistory.length %></span>
                  <span class="text-slate-400">clicks</span>
                </div>

                <form data-short-id="<%= url.shortId %>" onsubmit="deleteUrl(event)">
                  <button
                    type="submit"
                    class="rounded-lg p-2 text-slate-400 transition hover:bg-red-50 hover:text-red-600"
                    title="Delete link"
                    aria-label="Delete link"
                  >
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </form>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>

  <footer class="border-t border-slate-200/80 py-6 text-center text-sm text-slate-400">
    Shortly — simple, fast URL shortener
  </footer>

  <script>
    function getFullShortUrl(shortId) {
      return window.location.origin + '/' + shortId;
    }

    async function copyShortLink(shortId, btn) {
      const text = getFullShortUrl(shortId);
      try {
        await navigator.clipboard.writeText(text);
        const target = btn || document.getElementById('copy-btn');
        if (target) {
          const original = target.innerHTML;
          target.innerHTML = 'Copied!';
          target.classList.add('copy-success');
          setTimeout(() => {
            target.innerHTML = original;
            target.classList.remove('copy-success');
          }, 1600);
        }
      } catch {
        alert('Could not copy. Link: ' + text);
      }
    }

    async function deleteUrl(event) {
      event.preventDefault();
      if (!confirm('Delete this short link? This cannot be undone.')) return;

      const shortId = event.currentTarget.dataset.shortId;
      const response = await fetch('/urls/' + shortId, { method: 'DELETE' });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Unable to delete this link. Please try again.');
      }
    }
  </script>
</body>
</html>
