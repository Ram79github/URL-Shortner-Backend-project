<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Sign Up</title>
</head>
<body class="flex min-h-screen items-center justify-center bg-gray-100 p-4">
  <main class="w-full max-w-md rounded-lg bg-white p-6 shadow">
    <h1 class="text-2xl font-bold">Create an account</h1>
    <p class="mt-1 text-gray-600">Sign up to create and manage short URLs.</p>

    <form action="/user/signup" method="POST" class="mt-6 space-y-4">
      <div>
        <label for="name" class="mb-1 block font-medium">Name</label>
        <input id="name" name="name" type="text" required class="w-full rounded border border-gray-300 px-3 py-2" />
      </div>

      <div>
        <label for="email" class="mb-1 block font-medium">Email</label>
        <input id="email" name="email" type="email" required class="w-full rounded border border-gray-300 px-3 py-2" />
      </div>

      <div>
        <label for="password" class="mb-1 block font-medium">Password</label>
        <input id="password" name="password" type="password" minlength="6" required class="w-full rounded border border-gray-300 px-3 py-2" />
        <p class="mt-1 text-sm text-gray-600">Use at least 6 characters.</p>
      </div>

      <button type="submit" class="w-full rounded bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700">
        Create account
      </button>
    </form>

    <p class="mt-4 text-sm text-gray-600">
      Already have an account? <a href="/login" class="text-blue-600 underline">Log in</a>
    </p>
  </main>
</body>
</html>