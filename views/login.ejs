<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Login</title>
</head>
<body class="flex min-h-screen items-center justify-center bg-gray-100 p-4">
  <main class="w-full max-w-md rounded-lg bg-white p-6 shadow">
    <h1 class="text-2xl font-bold">Log in</h1>
    <p class="mt-1 text-gray-600">Use your account to manage your URLs.</p>

    <% if (locals.message) { %>
      <p class="mt-4 rounded border border-blue-200 bg-blue-50 p-3 text-blue-700"><%= message %></p>
    <% } %>

    <form action="/user/login" method="POST" class="mt-6 space-y-4">
      <div>
        <label for="email" class="mb-1 block font-medium">Email</label>
        <input id="email" name="email" type="email" required class="w-full rounded border border-gray-300 px-3 py-2" />
      </div>

      <div>
        <label for="password" class="mb-1 block font-medium">Password</label>
        <input id="password" name="password" type="password" required class="w-full rounded border border-gray-300 px-3 py-2" />
      </div>

      <button type="submit" class="w-full rounded bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700">
        Log in
      </button>
    </form>

    <p class="mt-4 text-sm text-gray-600">
      No account? <a href="/signup" class="text-blue-600 underline">Create one</a>
    </p>
  </main>
</body>
</html>
